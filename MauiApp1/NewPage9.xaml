<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.NewPage9"
             Title="NewPage9">
    <VerticalStackLayout>
        <Label 
            Text="Suwak"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Slider 
            x:Name="Suwak"
            Minimum="0"
            Maximum="255"
            Value="0"/>
        <Button
            Text="Zastosuj jako szarość"
            Clicked="Button_OnClicked"/>
        <Label 
            Text="{Binding Source={x:Reference Suwak}, Path=Value, StringFormat='Poziom: {0:F0}'}"/>
        <Label
            Text="Kolor rgb:"
            x:Name="LabelWynik"
            HeightRequest="50"/>
    </VerticalStackLayout>
</ContentPage>