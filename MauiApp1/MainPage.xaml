<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Label
                Text="Witaj w aplikacji"
                 x:Name="Przywitanie"
                FontSize="32"
                HorizontalOptions="Center"
                />
            <Button
                x:Name="Zmien"
                Text="Zmień Nazwę"
                Clicked="OnChangeWordClicked"
                HorizontalOptions="Fill"/>
            <Button
                x:Name="Reset"
                Text="Resetur"
                Clicked="OnResetWordClicked"
                HorizontalOptions="Fill"/>
            <Label
                Text="Kliknięcia: 0"
                x:Name="Licznik"
                HorizontalOptions="Center"/>
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
